# Claude Code config / cấu hình cục bộ (nhưng vẫn share skills cho cả team)
.claude/*
!.claude/skills/
!.claude/skills/**

# Secret OAuth credentials / token — không bao giờ push lên git
.claude/skills/*/credentials/
.claude/skills/**/token.json
.claude/skills/**/oauth_client.json
.claude/skills/**/.venv/
.claude/skills/**/__pycache__/

